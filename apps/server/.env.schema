# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @sensitive @type=url
DATABASE_URL=

# Id numérico do dono no Telegram. Vazio = toda mensagem é descartada.
# @sensitive @optional
TELEGRAM_OWNER_ID=

# @sensitive @optional
TELEGRAM_BOT_TOKEN=

# Segredo do header X-Telegram-Bot-Api-Secret-Token.
# @sensitive @optional
TELEGRAM_WEBHOOK_SECRET=

# URL pública do webhook, usada só no modo webhook.
# @optional
TELEGRAM_WEBHOOK_URL=

# @type=enum(webhook, polling, off)
TELEGRAM_MODE=off

# @sensitive @optional
GEMINI_API_KEY=

# Flash com áudio de entrada e JSON de saída. 1.5 Flash já saiu de linha.
GEMINI_MODEL=gemini-3.8-flash

# Gasto a partir deste valor, em centavos, pede confirmação. 10000 = R$ 100.
EXPENSE_CONFIRM_CENTS=10000

# Confiança abaixo disto, de 0 a 100, também pede confirmação.
CONFIDENCE_MIN=70

DASHBOARD_URL=http://localhost:3001

APP_TIMEZONE=America/Sao_Paulo

# Conta única do painel. Os dois preenchidos garantem esse e-mail e essa senha no boot.
# O e-mail volta na sessão, então não pode ser tratado como segredo.
# @optional
OWNER_EMAIL=

# @sensitive @optional
OWNER_PASSWORD=

