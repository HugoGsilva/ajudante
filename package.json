{
  "name": "ajudante",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.3",
      "varlock": "1.23.0",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.7.12",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@trpc/client": "^11.19.0",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @ajudante/db --",
    "db:studio": "turbo run db:studio -F @ajudante/db --",
    "db:generate": "turbo run db:generate -F @ajudante/db --",
    "db:migrate": "turbo run db:migrate -F @ajudante/db --",
    "db:start": "turbo run db:start -F @ajudante/db --",
    "db:watch": "turbo run db:watch -F @ajudante/db --",
    "db:stop": "turbo run db:stop -F @ajudante/db --",
    "db:down": "turbo run db:down -F @ajudante/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ajudante/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
